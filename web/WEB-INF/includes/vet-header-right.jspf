<%
    model.User vetHdrUser = (model.User) request.getAttribute("user");
    if (vetHdrUser == null && session != null) {
        vetHdrUser = (model.User) session.getAttribute("currentUser");
    }
    String vetHdrCtx = request.getContextPath();
    String vetHdrName = "";
    String vetHdrRole = "Veterinarian";
    if (vetHdrUser != null) {
        vetHdrName = (vetHdrUser.getFullName() != null && !vetHdrUser.getFullName().isEmpty())
                ? vetHdrUser.getFullName()
                : (vetHdrUser.getEmail() != null ? vetHdrUser.getEmail() : "");
        if (vetHdrUser.getRole() != null && vetHdrUser.getRole().getRoleName() != null) {
            vetHdrRole = vetHdrUser.getRole().getRoleName();
        }
    }
%>
<div class="flex items-center gap-3 sm:gap-4 shrink-0">
    <%@ include file="/WEB-INF/includes/notifications-dropdown.jsp" %>
    <div class="h-8 w-px bg-slate-200 dark:bg-slate-600 shrink-0" aria-hidden="true"></div>
    <div class="hidden sm:flex flex-col items-end justify-center text-right min-w-0 max-w-[180px] md:max-w-[260px]">
        <span class="text-sm font-bold text-slate-900 dark:text-slate-100 leading-tight truncate w-full"><%= vetHdrName %></span>
        <span class="text-xs font-medium text-slate-500 dark:text-slate-400 leading-tight mt-0.5 truncate w-full"><%= vetHdrRole %></span>
    </div>
    <div class="relative shrink-0">
        <button type="button"
                id="vet-profile-toggle"
                class="size-10 rounded-full bg-primary/20 flex items-center justify-center text-primary font-bold overflow-hidden hover:brightness-95 transition-colors">
            <% if (vetHdrUser != null && vetHdrUser.getProfilePictureUrl() != null && !vetHdrUser.getProfilePictureUrl().isEmpty()) { %>
            <img alt="" class="w-full h-full object-cover" src="<%= vetHdrCtx %><%= vetHdrUser.getProfilePictureUrl() %>"/>
            <% } else { %>
            <%= (vetHdrName != null && !vetHdrName.isEmpty()) ? String.valueOf(Character.toUpperCase(vetHdrName.charAt(0))) : "?" %>
            <% } %>
        </button>
        <div id="vet-profile-menu"
             class="absolute right-0 mt-2 w-56 origin-top-right rounded-xl bg-white dark:bg-slate-900 shadow-lg border border-slate-200 dark:border-slate-800 z-50"
             style="display:none;">
            <a href="<%= vetHdrCtx %>/vet/profile"
               class="block px-4 py-3 text-sm font-bold text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors rounded-t-xl flex items-center gap-2">
                <span class="material-symbols-outlined text-base text-primary">person</span>
                <span>My Profile</span>
            </a>
            <a href="<%= vetHdrCtx %>/logout"
               class="block px-4 py-3 text-sm font-bold text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors rounded-b-xl flex items-center gap-2">
                <span class="material-symbols-outlined text-base text-primary">logout</span>
                <span>Sign out</span>
            </a>
        </div>
    </div>
</div>
