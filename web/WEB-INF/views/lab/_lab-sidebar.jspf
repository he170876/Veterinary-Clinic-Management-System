<%-- Lab sidebar — Anipats Lab Clinical Terminal (shared) --%>
<%
    String labCtx = request.getContextPath();

    model.User sidebarUser = (model.User) request.getAttribute("user");
    if (sidebarUser == null && session != null) {
        sidebarUser = (model.User) session.getAttribute("currentUser");
    }

    String _labSidebarActive = (String) request.getAttribute("labSidebarActive");
    if (_labSidebarActive == null) _labSidebarActive = "";

    if (_labSidebarActive.isEmpty()) {
        String fwdServletPath = (String) request.getAttribute("jakarta.servlet.forward.servlet_path");
        if (fwdServletPath == null) fwdServletPath = (String) request.getAttribute("javax.servlet.forward.servlet_path");
        String fwdRequestUri = (String) request.getAttribute("jakarta.servlet.forward.request_uri");
        if (fwdRequestUri == null) fwdRequestUri = (String) request.getAttribute("javax.servlet.forward.request_uri");

        String currentPath = null;
        if (fwdServletPath != null && !fwdServletPath.isEmpty()) currentPath = fwdServletPath;
        else if (fwdRequestUri != null && !fwdRequestUri.isEmpty()) currentPath = fwdRequestUri;
        else currentPath = request.getRequestURI();
        if (currentPath == null) currentPath = "";
        if (labCtx != null && !labCtx.isEmpty() && currentPath.startsWith(labCtx)) {
            currentPath = currentPath.substring(labCtx.length());
        }

        if (currentPath.contains("/lab/labqueue") || currentPath.contains("/lab/dashboard")) _labSidebarActive = "queue";
        else if (currentPath.contains("/lab/profile") || currentPath.contains("/lab/edit-profile")) _labSidebarActive = "profile";
    }

    String queueNav = "queue".equals(_labSidebarActive)
            ? "flex items-center gap-3 px-4 py-3 text-[#FF7A00] font-bold bg-[#FFF7F0] rounded-xl transition-transform duration-200 active:scale-95"
            : "flex items-center gap-3 px-4 py-3 text-stone-600 hover:bg-stone-50 rounded-xl transition-colors text-sm font-medium";
    String profileNav = "profile".equals(_labSidebarActive)
            ? "flex items-center gap-3 px-4 py-3 text-[#FF7A00] font-bold bg-[#FFF7F0] rounded-xl transition-transform duration-200 active:scale-95"
            : "flex items-center gap-3 px-4 py-3 text-stone-600 hover:bg-stone-50 rounded-xl transition-colors text-sm font-medium";
%>

<aside class="h-screen w-64 fixed left-0 top-0 bg-white border-r border-stone-100 flex flex-col p-6 space-y-8 z-50">
    <div class="flex items-center gap-3">
        <div class="w-10 h-10 bg-[#FF7A00] rounded-lg flex items-center justify-center text-white shrink-0">
            <span class="material-symbols-outlined text-2xl">pets</span>
        </div>
        <div>
            <h2 class="text-xl font-bold tracking-tight text-stone-900 font-headline">Anipats Lab</h2>
            <p class="text-[10px] uppercase tracking-widest text-stone-500 font-bold">Clinical Terminal</p>
        </div>
    </div>

    <nav class="flex-1 space-y-2">
        <a class="<%= queueNav %>" href="<%= labCtx %>/lab/labqueue">
            <span class="material-symbols-outlined text-xl" style="font-variation-settings: 'FILL' <%= "queue".equals(_labSidebarActive) ? "1" : "0" %>;">list_alt</span>
            <span class="text-sm">Lab Queue</span>
        </a>
        <a class="<%= profileNav %>" href="<%= labCtx %>/lab/profile">
            <span class="material-symbols-outlined text-xl" style="font-variation-settings: 'FILL' <%= "profile".equals(_labSidebarActive) ? "1" : "0" %>;">person</span>
            <span class="text-sm">My Profile</span>
        </a>
        <a class="<%= _labProfileClass %>" href="<%= labCtx %>/lab/profile">
            <span class="material-symbols-outlined">person</span>
            <span>My Profile</span>
        </a>
    </nav>
</aside>
