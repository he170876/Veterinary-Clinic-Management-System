<%
    String sidebarCtx = request.getContextPath();
    model.User sidebarUser = (model.User) request.getAttribute("user");
    if (sidebarUser == null && session != null) {
        sidebarUser = (model.User) session.getAttribute("currentUser");
    }
    String sidebarRoleTitle = (sidebarUser != null && sidebarUser.getRole() != null && sidebarUser.getRole().getRoleName() != null)
            ? sidebarUser.getRole().getRoleName() : "Veterinarian";
    // Robust active detection (handles servlet forward + url variations)
    String fwdServletPath = (String) request.getAttribute("jakarta.servlet.forward.servlet_path");
    if (fwdServletPath == null) fwdServletPath = (String) request.getAttribute("javax.servlet.forward.servlet_path");
    String fwdRequestUri = (String) request.getAttribute("jakarta.servlet.forward.request_uri");
    if (fwdRequestUri == null) fwdRequestUri = (String) request.getAttribute("javax.servlet.forward.request_uri");

    String currentPath = null;
    if (fwdServletPath != null && !fwdServletPath.isEmpty()) currentPath = fwdServletPath;
    else if (fwdRequestUri != null && !fwdRequestUri.isEmpty()) currentPath = fwdRequestUri;
    else currentPath = request.getRequestURI();
    if (currentPath == null) currentPath = "";

    if (sidebarCtx != null && !sidebarCtx.isEmpty() && currentPath.startsWith(sidebarCtx)) {
        currentPath = currentPath.substring(sidebarCtx.length());
    }

    boolean onDashboard = currentPath.contains("/vet/dashboard");
    boolean onQueue = currentPath.contains("/vet/queue") || currentPath.contains("/vet/examination");
    boolean onRecords = currentPath.contains("/vet/records") || currentPath.contains("/vet/record");
%>
<!-- Unified Vet Sidebar -->
<aside id="vet-sidebar" class="hidden lg:flex w-64 flex-shrink-0 border-r border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 flex-col">
    <div class="p-6 flex items-center gap-3">
        <div class="size-10 bg-primary rounded-lg flex items-center justify-center text-white">
            <span class="material-symbols-outlined text-2xl">pets</span>
        </div>
        <div>
            <h1 class="text-xl font-bold tracking-tight text-slate-900 dark:text-white">Anipats</h1>
            <p class="text-xs text-slate-500 dark:text-slate-400 font-medium">Veterinary Care</p>
        </div>
    </div>
    <nav class="flex-1 px-4 space-y-2 mt-4">
        <a class="flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium transition-colors
                  text-slate-600 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-800<%= onDashboard ? " bg-primary/10 text-primary" : "" %>"
           href="<%= sidebarCtx %>/vet/dashboard">
            <span class="material-symbols-outlined">dashboard</span>
            <span>Dashboard</span>
        </a>
        <a class="flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium transition-colors
                  text-slate-600 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-800<%= onQueue ? " bg-primary/10 text-primary" : "" %>"
           href="<%= sidebarCtx %>/vet/queue">
            <span class="material-symbols-outlined">group_work</span>
            <span>Patients Queue</span>
        </a>
        <a class="flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium transition-colors
                  text-slate-600 dark:text-slate-400 hover:bg-slate-50 dark:hover:bg-slate-800<%= onRecords ? " bg-primary/10 text-primary" : "" %>"
           href="<%= sidebarCtx %>/vet/records">
            <span class="material-symbols-outlined">calendar_today</span>
            <span class="text-sm font-medium">Medical Records</span>
        </a>
    </nav>
</aside>

<script>
window.addEventListener('load', function() {
  var btn = document.getElementById('sidebar-toggle');
  var sidebar = document.getElementById('vet-sidebar');
  if (btn && sidebar) {
    btn.addEventListener('click', function() {
      if (sidebar.classList.contains('hidden')) {
        sidebar.classList.remove('hidden');
      } else {
        sidebar.classList.add('hidden');
      }
    });
  }
});
</script>


